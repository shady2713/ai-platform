# AI 平台部署配置模板（占位符，不含任何真实凭据）
#
# 用法：复制为部署环境实际使用的变量文件（如后端目录 .env，见 docs/deployment.md），
# 替换全部 replace-with-* 占位值后由编排平台注入。本模板永远不提交填充后的副本。
#
# 秘密来源（禁止写进仓库、镜像、命令行历史或工单）：
#   - 生产使用部署方密钥管理（KMS/Vault/容器 Secret）生成并注入；
#   - 本机演练可用 `openssl rand -base64 32`、`openssl rand -hex 32` 生成后只写入被 gitignore 的本地文件；
#   - 轮换流程见 docs/deployment.md 的“已有实例的数据库凭据轮换”。
#
# prod profile 启动期 fail-closed 校验（ProductionConfigurationEnvironmentPostProcessor）：
#   必填项缺失/占位/弱默认值、应用与迁移账号同名、CORS 非精确 HTTPS Origin（含示例域名与本机地址）、
#   credential-encryption-key 不是 32 字节 Base64，任一不满足都会拒绝启动。

# ---- MySQL ----
# root 仅容器初始化与运维处置使用，不注入应用进程。
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
# 运行时应用账号（仅业务 DML；与应用迁移账号必须不同名，见 ADR 0009）。
DB_USERNAME=framework_app
DB_PASSWORD=replace-with-strong-app-password
# Flyway 迁移账号（DDL + 迁移元数据；只在启动迁移期使用）。
FLYWAY_USERNAME=framework_migrator
FLYWAY_PASSWORD=replace-with-strong-flyway-password
# 仅在编排模板提供 DB_HOST/DB_PORT/DB_NAME 时使用；compose 默认 mysql:3306/basic_framework。
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=basic_framework

# ---- Redis ----
REDIS_PASSWORD=replace-with-strong-redis-password
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DATABASE=0

# ---- 应用安全 ----
# 32 字节随机密钥的 Base64（生成：openssl rand -base64 32）。轮换会使既有可恢复密文不可解，需按轮换方案执行。
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# 管理端对外域名：精确 HTTPS Origin，禁止通配符/路径/localhost/示例域名；多个 Origin 用英文逗号分隔。
CORS_ALLOWED_ORIGIN=https://admin.internal.example
# 仅激活种子管理员时设置（每个部署独立生成），激活后删除该变量。
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 会话与登录保护（可选；默认值见 application.yaml）----
# SESSION_ACCESS_TOKEN_TTL=30m
# SESSION_REFRESH_TOKEN_TTL=30d
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_DURATION=15m

# ---- 文件上传（可选）----
# FILE_PRESIGNED_UPLOAD_TTL=15m
# FILE_PRESIGNED_UPLOAD_MAX_SIZE=16MB

# ---- 短信回调（默认关闭）----
SMS_CALLBACK_ENABLED=false
# 启用时用 openssl rand -hex 32 单独生成；不得复用其他令牌。
SMS_CALLBACK_TOKEN=
# SMS_CALLBACK_MAX_PAYLOAD_LENGTH=1048576

# ---- Prometheus 抓取（默认关闭）----
PROMETHEUS_ENABLED=false
# 启用时单独生成 32 字节随机值（64 位十六进制）；抓取端以只读 Secret 文件消费，见 docs/deployment.md。
PROMETHEUS_SCRAPE_TOKEN=

# ---- 嵌入页产物目录（C05）----
# 本项不是环境变量直连：应用属性为 basic-framework.ai.embed.assets-directory，
# 部署时把交付包的 frontend/embed-assets/ 目录放到容器可读路径，并通过编排参数注入，例如：
#   ARGS="--basic-framework.ai.embed.assets-directory=/opt/ai-platform/embed-assets"
# 目录必须包含 asset-manifest.json（交付包已生成）；缺失或与磁盘 sha256 不一致时嵌入页返回稳定错误码，不返回空壳。
# EMBED_ASSETS_DIRECTORY=/opt/ai-platform/embed-assets
