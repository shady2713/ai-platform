<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.basicframework</groupId>
        <artifactId>basic-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>basic-framework-module-system</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        system 模块下，我们放通用业务，支撑上层的核心业务。
        例如说：用户、部门、权限、数据字典等等
    </description>

    <dependencies>
        <!-- 安全信号指标（威胁模型 T1/T2/T3 的运行期可观测性）：只依赖 micrometer-core API，
             注册表由应用侧 spring-boot-starter-actuator 提供。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- 对外契约薄模块：本模块 api 包的 CommonApi 接口与 DTO -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-module-system-api</artifactId>
        </dependency>
        <!-- 业务组件 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>

        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-biz-ip</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 服务保障：限流等 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-protection</artifactId>
        </dependency>
        <dependency>
            <!-- starter-protection 中为 optional；短信验证码发送按手机号使用 @Lock4j 串行化。 -->
            <groupId>com.baomidou</groupId>
            <artifactId>lock4j-redisson-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Job 定时任务相关 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-spring-boot-starter-excel</artifactId>
        </dependency>

        <dependency>
            <groupId>com.anji-plus</groupId>
            <artifactId>captcha-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率棘轮门禁：短信供应商请求边界可测试化后行覆盖率 75.04%，取 75%，只升不降 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.750</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
