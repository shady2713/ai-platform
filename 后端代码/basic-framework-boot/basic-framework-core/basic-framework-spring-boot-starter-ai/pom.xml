<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.basicframework</groupId>
        <artifactId>basic-framework-core</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>basic-framework-spring-boot-starter-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        AI 能力接缝：自有模型契约（core.model）、唯一允许引用 Spring AI 的 provider.springai 区域，
        以及启动期装配校验。业务模块只消费本 starter 的契约，不直接依赖厂商类型。
    </description>

    <dependencies>
        <!-- 框架基础类型 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-common</artifactId>
        </dependency>

        <!-- 配置校验：AiProperties 的 @Validated 绑定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 厂商接缝：唯一允许直接引用 Spring AI 的区域为 provider.springai 包；
             spring-ai-model 提供 ChatModel/EmbeddingModel 等模型 API；
             版本由 basic-framework-dependencies 的 spring-ai-bom 统一管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- OpenAI 兼容客户端（受管工厂按端点快照创建；版本同样由 spring-ai-bom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率棘轮门禁：契约与启动校验全量覆盖后行覆盖率 100%，只升不降 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- F03 骨架期为 1.000；M02 起包含真实提供方实现（受管客户端/工厂/缓存），
                                                 按 2026-09-17 实测 86.4% 取 0.860，只升不降；
                                                 厂商真实调用路径由 module-ai 侧集成用例覆盖。 -->
                                            <minimum>0.860</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
