<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.basicframework</groupId>
        <artifactId>basic-framework-core</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>basic-framework-spring-boot-starter-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        AI 能力接缝：自有模型契约（core.model）、唯一允许引用 Spring AI 的 provider.springai 区域，
        以及启动期装配校验。业务模块只消费本 starter 的契约，不直接依赖厂商类型。
    </description>

    <dependencies>
        <!-- 框架基础类型 -->
        <dependency>
            <groupId>com.basicframework</groupId>
            <artifactId>basic-framework-common</artifactId>
        </dependency>

        <!-- 配置校验：AiProperties 的 @Validated 绑定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 厂商接缝：唯一允许直接引用 Spring AI 的区域为 provider.springai 包；
             spring-ai-model 提供 ChatModel/EmbeddingModel 等模型 API；
             版本由 basic-framework-dependencies 的 spring-ai-bom 统一管理 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>

        <!-- OpenAI 兼容客户端（受管工厂按端点快照创建；版本同样由 spring-ai-bom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- MCP 客户端（X07）：唯一允许直接引用 io.modelcontextprotocol.sdk 的区域为 provider.mcp 包。
             本卡只做客户端（协议级 tools/list 取数，不代执行）；不引入 spring-ai-mcp starter，
             理由见 basic-framework-dependencies 的同组注释与 X07.md §2.1。
             版本由 basic-framework-dependencies 的 ${mcp-sdk.version} 统一管理，此处不写死版本。 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- X07 §2.2 授权（仅 test 作用域）：Streamable HTTP 传输层端到端验证的最小运行时。
             mcp-core 把 jakarta.servlet-api 声明为 provided 作用域（不传递），而 SDK 自带的
             HttpServletStreamableServerTransportProvider 继承 HttpServlet，没有它本模块连编译都过不了
             （上一轮实测：找不到 jakarta.servlet.http.HttpServlet 的类文件）。
             这两条只服务于 McpStreamableHttpE2ETest 的嵌入式容器，不得进 compile/provided。
             版本不写死：jakarta.servlet-api 由 Spring Boot 依赖管理给出（3.5.16 → 6.0.0），
             tomcat-embed-core 由 basic-framework-dependencies 显式钉到仓库既有修复线 10.1.59
             （Boot 默认 10.1.55 携带 CVE-2026-65182，仓库已统一升版，此处沿用不新造版本）。 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 与仓库既有 Tomcat 用法保持一致：spring-boot-starter-tomcat 对
                     tomcat-embed-core 同样排除 tomcat-annotations-api。该 jar 只服务于
                     @WebServlet/@WebListener 注解扫描，本夹具用 Tomcat.addServlet 编程式注册，
                     不走注解扫描；留着反而会被 Spring Boot 依赖管理降到未修复的 10.1.55。 -->
                <exclusion>
                    <groupId>org.apache.tomcat</groupId>
                    <artifactId>tomcat-annotations-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率棘轮门禁：契约与启动校验全量覆盖后行覆盖率 100%，只升不降 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- F03 骨架期为 1.000；M02 起包含真实提供方实现（受管客户端/工厂/缓存），
                                                 按 2026-09-17 实测 86.4% 取 0.860，只升不降；
                                                 厂商真实调用路径由 module-ai 侧集成用例覆盖。 -->
                                            <minimum>0.860</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
