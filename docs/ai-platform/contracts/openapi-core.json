    "/runs/{runId}/events": {
      "get": {
        "operationId": "streamRunEvents",
        "summary": "按seq重放并继续订阅运行；使用带Bearer的fetch流",
        "security": [
          {
            "PlatformBearer": []
          }
        ],
        "x-required-scope": "runs:read",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^run_[A-Za-z0-9_-]{3,35}$",
              "maxLength": 40
            }
          },
          {
            "name": "afterSeq",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "description": "与afterSeq同时提供且不一致时400。"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE事件；心跳为注释行，不推进seq。结构块完成后才渲染，流中失败使用run.failed。",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "id: 1\nevent: run.accepted\ndata: {\"protocolVersion\":\"1.0\",\"runId\":\"run_demo\",\"seq\":1,\"type\":\"run.accepted\",\"occurredAt\":\"2026-09-16T00:00:00Z\",\"data\":{\"status\":\"QUEUED\"}}\n\n: heartbeat\n\n"
              }
            }
          },
          "401": {
            "description": "语义错误，code为实施时字段/错误码目录中登记的稳定业务码；msg不包含秘密。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "语义错误，code为实施时字段/错误码目录中登记的稳定业务码；msg不包含秘密。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "语义错误，code为实施时字段/错误码目录中登记的稳定业务码；msg不包含秘密。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "重放窗口已过期；读取run快照，禁止重新创建运行。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
