    "securitySchemes": {
      "ClientBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "仅可信业务后端持有appKey:appSecret；不是浏览器身份认证。"
      },
      "PlatformBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "中台随机短期票据，不是后台ADMIN token。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "integer",
            "not": {
              "const": 0
            }
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "Scope": {
        "enum": [
          "services:read",
          "runs:execute",
          "runs:read",
          "runs:cancel",
          "conversations:write",
          "files:write",
          "files:read",
          "knowledge:search",
          "knowledge:write",
          "reports:read",
          "reports:write",
          "reports:refresh",
          "actions:confirm"
        ]
      },
      "TokenRequest": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subjectKind": {
                "const": "APP"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Scope"
                },
                "minItems": 0,
                "maxItems": 30
              },
              "serviceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^svc_[A-Za-z0-9_-]{3,35}$",
                  "maxLength": 40
                },
                "minItems": 0,
                "maxItems": 30
              }
            },
            "required": [
              "subjectKind"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subjectKind": {
                "const": "USER"
              },
              "externalUserId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "scopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Scope"
                },
                "minItems": 0,
                "maxItems": 30
              },
              "serviceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^svc_[A-Za-z0-9_-]{3,35}$",
                  "maxLength": 40
                },
                "minItems": 0,
                "maxItems": 30
              }
            },
            "required": [
              "subjectKind",
              "externalUserId"
            ]
          }
        ]
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accessToken": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "tokenType": {
                "const": "Bearer"
              },
              "expiresIn": {
                "type": "integer",
                "minimum": 1
              },
              "subjectId": {
                "type": "string",
                "pattern": "^sub_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "scopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Scope"
                },
                "minItems": 0,
                "maxItems": 30
              }
            },
            "required": [
              "accessToken",
              "tokenType",
              "expiresIn",
              "subjectId",
              "scopes"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "BusinessContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "objectType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "filters": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ],
              "maxLength": 1000
            }
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": []
      },
      "CreateRun": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "serviceId": {
            "type": "string",
            "pattern": "^svc_[A-Za-z0-9_-]{3,35}$",
            "maxLength": 40
          },
          "conversationId": {
            "type": "string",
            "pattern": "^conv_[A-Za-z0-9_-]{3,35}$",
            "maxLength": 40
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^file_[A-Za-z0-9_-]{3,35}$",
              "maxLength": 40
            },
            "minItems": 0,
            "maxItems": 10
          },
          "context": {
            "$ref": "#/components/schemas/BusinessContext"
          }
        },
        "required": [
          "serviceId",
          "message"
        ]
      },
      "RunStatus": {
        "enum": [
          "QUEUED",
          "RUNNING",
          "WAITING_INPUT",
          "WAITING_CONFIRMATION",
          "SUCCEEDED",
          "FAILED",
          "CANCELLED"
        ]
      },
      "RunAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runId": {
                "type": "string",
                "pattern": "^run_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "status": {
                "$ref": "#/components/schemas/RunStatus"
              },
              "links": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "self": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "events": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "self",
                  "events"
                ]
              }
            },
            "required": [
              "runId",
              "status",
              "links"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "ResultBlock": {
        "description": "核心规范先定义文本、澄清及report引用；其他类型在拥有方任务交付时加入同一判别联合，完整目录见04。",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "maxLength": 50000
              }
            },
            "required": [
              "type",
              "id",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "clarification"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minItems": 0,
                "maxItems": 10
              }
            },
            "required": [
              "type",
              "id",
              "question",
              "options"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "report"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "reportId": {
                "type": "string",
                "pattern": "^rpt_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "id",
              "reportId",
              "version"
            ]
          }
        ]
      },
      "RunSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runId": {
                "type": "string",
                "pattern": "^run_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "serviceReleaseId": {
                "type": "string",
                "pattern": "^rel_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "modelRevision": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "$ref": "#/components/schemas/RunStatus"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ResultBlock"
                },
                "minItems": 0,
                "maxItems": 40
              },
              "completeness": {
                "enum": [
                  "COMPLETE",
                  "PARTIAL",
                  "UNKNOWN"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "minItems": 0,
                "maxItems": 20
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "completedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "runId",
              "serviceReleaseId",
              "status",
              "blocks",
              "completeness",
              "warnings",
              "createdAt",
              "completedAt"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "ConversationCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "serviceId": {
            "type": "string",
            "pattern": "^svc_[A-Za-z0-9_-]{3,35}$",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "serviceId"
        ]
      },
      "ConversationResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conversationId": {
                "type": "string",
                "pattern": "^conv_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "serviceReleaseId": {
                "type": "string",
                "pattern": "^rel_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "conversationId",
              "serviceReleaseId",
              "title",
              "version"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "SaveReport": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^run_[A-Za-z0-9_-]{3,35}$",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "SNAPSHOT",
              "REFRESHABLE"
            ]
          }
        },
        "required": [
          "runId",
          "title",
          "mode"
        ]
      },
      "ReportResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reportId": {
                "type": "string",
                "pattern": "^rpt_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "mode": {
                "enum": [
                  "SNAPSHOT",
                  "REFRESHABLE"
                ]
              },
              "spec": {
                "$ref": "./report-spec.schema.json"
              },
              "resultRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "minItems": 1,
                "maxItems": 20
              }
            },
            "required": [
              "reportId",
              "version",
              "mode",
              "spec",
              "resultRefs"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "ReportSaved": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reportId": {
                "type": "string",
                "pattern": "^rpt_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "reportId",
              "version"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "ExpectedVersion": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "TaskAccepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "taskId": {
                "type": "string",
                "pattern": "^task_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "state": {
                "enum": [
                  "PENDING",
                  "RUNNING",
                  "RETRY_WAIT",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED",
                  "UNKNOWN"
                ]
              }
            },
            "required": [
              "taskId",
              "state"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "ActionConfirm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "challengeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "challengeId",
          "expectedVersion"
        ]
      },
      "Acknowledged": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "accepted"
            ]
          }
        },
        "required": [
          "code",
          "msg",
          "data"
        ]
      },
      "CancelRun": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "TaskSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "msg",
          "data"
        ],
        "properties": {
          "code": {
            "const": 0
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "state",
              "progress",
              "errorCode"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "pattern": "^task_[A-Za-z0-9_-]{3,35}$",
                "maxLength": 40
              },
              "state": {
                "enum": [
                  "PENDING",
                  "RUNNING",
                  "RETRY_WAIT",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED",
                  "UNKNOWN"
                ]
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "errorCode": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "resultRef": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              }
            }
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "语义错误，code为实施时字段/错误码目录中登记的稳定业务码；msg不包含秘密。",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
