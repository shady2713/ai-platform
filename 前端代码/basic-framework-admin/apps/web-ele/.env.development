# 端口号
VITE_PORT=5174

VITE_BASE=/

# 应用标题：注入 index.html 的 <title>，并作为偏好里的 app.name 与页脚公司名
VITE_APP_TITLE=管理后台
# 应用唯一标识与版本：拼出偏好存储的 namespace（localStorage key 前缀），
# 用于按项目与版本隔离偏好设置，缺失会让 namespace 退化成 undefined-undefined-dev
VITE_APP_NAMESPACE=basic-framework-admin
VITE_APP_VERSION=1.0.0

# 路由模式：显式写 history。router/index.ts 对该值无兜底，
# 留空会静默采用 history——本地本就该是 history，写出来是为了让意图可见。
VITE_ROUTER_HISTORY=history

# 请求路径
# 接口地址
VITE_GLOB_API_URL=http://127.0.0.1:48080/admin-api
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 验证码开关：显式写 false，而不是留空。
# isCaptchaEnable() 判定 `=== 'true'`，留空等于静默关闭且无任何告警；
# 显式写出能让"本地不启用验证码"成为一个决定而不是一次疏忽，
# 也让 preferences.test.ts 的配置守卫能拦住它被误删。
VITE_APP_CAPTCHA_ENABLE=false