VITE_BASE=/

# 应用标题：注入 index.html 的 <title>，并作为偏好里的 app.name 与页脚公司名
VITE_APP_TITLE=管理后台
# 应用唯一标识与版本：拼出偏好存储的 namespace（localStorage key 前缀），
# 用于按项目与版本隔离偏好设置，缺失会让 namespace 退化成 undefined-undefined-prod
VITE_APP_NAMESPACE=basic-framework-admin
VITE_APP_VERSION=1.0.0

# 请求路径 - 部署时替换为实际生产域名
# 接口地址 - 部署时替换为实际生产域名
VITE_GLOB_API_URL=https://api.example.com/admin-api
# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true